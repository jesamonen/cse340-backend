<%- include('partials/header') %>

<main class="container">

  <section class="page-heading">
    <h1>Community Service Projects</h1>
    <p>Explore activities that help improve lives and strengthen communities.</p>
  </section>

  <section class="card-grid">

    <% if (projects && projects.length > 0) { %>

      <% projects.forEach(project => { %>

        <article class="card">

          <h2>
            <a href="/project/<%= project.project_id %>">
              <%= project.formatted_date %>: <%= project.title %>
            </a>
          </h2>

          <p>
            <strong>Organization:</strong>
            <%= project.organization_name %>
          </p>

          <p><%= project.description %></p>

          <p>
            <strong>Location:</strong>
            <%= project.location %>
          </p>

          <p>
            <strong>Categories:</strong>
            <%= project.categories %>
          </p>

          <a href="/project/<%= project.project_id %>">
            View Project Details
          </a>

        </article>

      <% }) %>

    <% } else { %>

      <p>No service projects are currently available.</p>

    <% } %>

  </section>

</main>

<%- include('partials/footer') %>
