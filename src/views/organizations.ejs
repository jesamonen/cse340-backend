<%- include('partials/header') %>

<main class="container">
  <section class="page-heading">
    <h1>Community Organizations</h1>
    <p>Discover organizations dedicated to making a positive difference.</p>
  </section>

  <section class="card-grid">
    <% if (organizations && organizations.length > 0) { %>

      <% organizations.forEach(organization => { %>

        <article class="card">

          <img
            src="/images/<%= organization.logo_filename %>"
            alt="<%= organization.name %> logo"
            loading="lazy"
          >

          <h2>
            <a href="/organization/<%= organization.organization_id %>">
              <%= organization.name %>
            </a>
          </h2>

          <p><%= organization.description %></p>

          <p>
            <strong>Contact:</strong>
            <%= organization.contact_email %>
          </p>

          <a href="/organization/<%= organization.organization_id %>">
            View Organization
          </a>

        </article>

      <% }) %>

    <% } else { %>

      <p>No organizations are currently available.</p>

    <% } %>
  </section>
</main>

<%- include('partials/footer') %>